{
  "name": "pinway-ide",
  "productName": "Pinway IDE",
  "version": "0.1.0",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "dev": "npm run ui && electron .",
    "ui": "esbuild src/ui.js --bundle --outfile=src/ui.bundle.js",
    "seed": "bash scripts/toolchain.sh",
    "package": "npm run ui && bash scripts/assets.sh && node scripts/package.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:app": "node scripts/smoke.cjs",
    "ui:tauri": "npm run ui && node scripts/tauri-ui.cjs",
    "package:tauri": "bash scripts/package-tauri.sh"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lint": "6.9.8",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "@electron/packager": "20.3.0",
    "@tauri-apps/cli": "2.12.5",
    "codemirror": "6.0.2",
    "electron": "45.3.3",
    "esbuild": "0.28.2",
    "playwright-core": "1.65.1"
  }
}
