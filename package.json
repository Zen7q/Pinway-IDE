{
  "name": "pinway-ide",
  "productName": "Pinway IDE",
  "version": "0.3.2",
  "private": true,
  "scripts": {
    "dev": "bash scripts/package-tauri.sh --dev",
    "ui": "esbuild src/ui.js --bundle --minify --target=safari15 --outfile=src/ui.bundle.js",
    "seed": "bash scripts/toolchain.sh",
    "package": "npm run package:tauri",
    "test": "bash scripts/package-tauri.sh --test",
    "ui:tauri": "npm run ui && node scripts/tauri-ui.cjs",
    "package:tauri": "python3 scripts/package-desktop.py",
    "test:display": "node --test tests/display-model.test.mjs",
    "addons": "node scripts/build-addons.mjs && python3 scripts/display-libraries.py --verify && python3 scripts/package-addons.py",
    "package:dmg": "python3 scripts/package-desktop.py"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lint": "6.9.8",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "@tauri-apps/cli": "2.12.5",
    "codemirror": "6.0.2",
    "esbuild": "0.28.2"
  }
}
