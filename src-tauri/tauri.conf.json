{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pinway IDE",
  "version": "0.3.2-alpha",
  "identifier": "dev.binio.pinway.tauri",
  "build": {
    "frontendDist": "../dist/tauri-ui",
    "beforeBuildCommand": "npm run ui:tauri",
    "beforeDevCommand": "npm run ui:tauri"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pinway IDE",
        "width": 1320,
        "height": 820,
        "minWidth": 830,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false,
        "trafficLightPosition": {
          "x": 14,
          "y": 26
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": [
      "../.toolchain/icons/icon.icns",
      "../.toolchain/icons/icon.ico",
      "../.toolchain/icons/128x128.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "resources": {
      "../.toolchain/release-runtime/": "arduino/",
      "../.toolchain/legal/": "legal/"
    }
  }
}
