#include <Arduino.h>
#include <math.h>
#include "display_ui.h"
#include "touch.h"
#include "scene_data.h"
#include "runtime.h"
extern int pinwaySceneRead();
extern void pinwaySceneWrite(int);
namespace {
using namespace PinwayHardware;
using namespace PinwayScene;
uint16_t pixels[WIDTH*8];
bool ready=false,wasDown=false;
int page=0,previousPage=-1,previousValue=INT_MIN,activeSlider=-1,activeButton=-1;
uint32_t lastPress=0;
void redraw(int value){
 const auto& p=pages[page];const auto& frame=frames[p.frameFirst+value-(MINIMUM)];
 for(int row=0;row<HEIGHT;row+=8){
  const uint32_t first=uint32_t(row)*WIDTH,last=first+WIDTH*min(8,HEIGHT-row);uint32_t at=0;
  for(uint32_t i=p.baseFirst;i<p.baseFirst+p.baseCount;i++){
   const auto& r=bases[i];uint32_t end=at+r.count;
   for(uint32_t k=max(at,first);k<min(end,last);k++)pixels[k-first]=r.color;
   at=end;if(at>=last)break;
  }
  for(uint32_t i=frame.first;i<frame.first+frame.count;i++){
   const auto& r=patches[i];for(uint32_t k=max(r.index,first);k<min(r.index+r.count,last);k++)pixels[k-first]=r.color;
  }
  displayPixelRows(pixels,row,min(8,HEIGHT-row));
 }
}
bool inside(int x,int y,int sx,int sy,int w,int h){return x>=sx&&y>=sy&&x<sx+w&&y<sy+h;}
}
void pinwayDisplaySetup(){
 PinwayHardware::displayBegin();PinwayHardware::touchBegin();ready=true;pinwayDisplayTick();
}
void pinwayDisplayTick(){
 if(!ready)return;
 int x,y;bool down;
 if(PinwayHardware::touchPosition(x,y,down)){
  const auto& p=pages[page];
  if(down&&!wasDown){
   activeSlider=activeButton=-1;
   for(uint32_t i=p.sliderFirst;i<p.sliderFirst+p.sliderCount;i++){const auto& s=sliders[i];if(inside(x,y,s.x,s.y,s.w,s.h))activeSlider=i;}
   for(uint32_t i=p.buttonFirst;i<p.buttonFirst+p.buttonCount;i++){const auto& b=buttons[i];if(inside(x,y,b.x,b.y,b.w,b.h))activeButton=i;}
  }
  if(down&&activeSlider>=0){const auto& s=sliders[activeSlider];double ratio=constrain(double(x-s.x)/double(max(1,s.w-1)),0.0,1.0);pinwaySceneWrite(lround(MINIMUM+ratio*(MAXIMUM-MINIMUM)));}
  if(!down&&wasDown&&activeButton>=0){
   const auto& b=buttons[activeButton];uint32_t now=millis();
   if(inside(x,y,b.x,b.y,b.w,b.h)&&uint32_t(now-lastPress)>=250){lastPress=now;if(b.kind==1)page=b.target;else if(b.kind==2)pinwaySceneWrite(!pinwaySceneRead());else pinwaySceneWrite(b.target);}
  }
  if(!down)activeSlider=activeButton=-1;
  wasDown=down;
 }
 int value=constrain(pinwaySceneRead(),MINIMUM,MAXIMUM);
 if(value!=previousValue||page!=previousPage){previousValue=value;previousPage=page;redraw(value);}
}
void pinwayDisplayDelay(unsigned long duration){
 const uint32_t start=millis();
 do{pinwayDisplayTick();::delay(1);}while(uint32_t(millis()-start)<duration);
}
